{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-reactrouter.local/contracts/plugin-manifest.schema.json",
  "title": "Runtime Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "displayName",
    "version",
    "apiVersion",
    "coreRequires",
    "backend",
    "frontend",
    "permissions",
    "menus",
    "openapi"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-.][0-9A-Za-z.-]+)?$" },
    "apiVersion": { "type": "string", "pattern": "^\\d+$" },
    "coreRequires": { "type": "string", "minLength": 1 },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "healthPath", "apiPrefix"],
      "properties": {
        "entrypoint": { "type": "string", "minLength": 1 },
        "healthPath": { "type": "string", "pattern": "^/" },
        "apiPrefix": { "type": "string", "pattern": "^/api/" }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint"],
      "properties": {
        "entrypoint": { "type": "string", "minLength": 1 }
      }
    },
    "permissions": { "type": "string", "minLength": 1 },
    "menus": { "type": "string", "minLength": 1 },
    "openapi": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 1 }
  }
}
