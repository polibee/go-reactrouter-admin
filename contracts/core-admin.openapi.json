{
  "openapi": "3.1.0",
  "info": {
    "title": "GoReactRouter Core Admin Resource API",
    "version": "1.1.0",
    "description": "Permission-protected Core resource CRUD and audit-log reads. This contract is the source for Swagger and generated clients."
  },
  "servers": [{ "url": "/api/v1/admin" }],
  "x-permissions": {
    "listUsers": "users.view", "getUser": "users.view", "createUser": "users.create", "updateUser": "users.update", "deleteUser": "users.delete",
    "listRoles": "roles.view", "getRole": "roles.view", "createRole": "roles.create", "updateRole": "roles.update", "deleteRole": "roles.delete",
    "listPermissions": "permissions.view", "getPermission": "permissions.view", "createPermission": "permissions.create", "updatePermission": "permissions.update", "deletePermission": "permissions.delete",
    "listMenus": "menus.view", "getMenu": "menus.view", "createMenu": "menus.create", "updateMenu": "menus.update", "deleteMenu": "menus.delete",
    "listSettings": "settings.view", "getSetting": "settings.view", "createSetting": "settings.create", "updateSetting": "settings.update", "deleteSetting": "settings.delete",
    "listAuditLogs": "audit.view", "listPlugins": "plugins.view", "validatePlugin": "plugins.validate"
  },
  "paths": {
    "/users": { "$ref": "#/components/pathItems/Users" },
    "/users/{id}": { "$ref": "#/components/pathItems/UserWithGet" },
    "/roles": { "$ref": "#/components/pathItems/Roles" },
    "/roles/{id}": { "$ref": "#/components/pathItems/RoleWithGet" },
    "/permissions": { "$ref": "#/components/pathItems/Permissions" },
    "/permissions/{id}": { "$ref": "#/components/pathItems/PermissionWithGet" },
    "/menus": { "$ref": "#/components/pathItems/Menus" },
    "/menus/{id}": { "$ref": "#/components/pathItems/MenuWithGet" },
    "/settings": { "$ref": "#/components/pathItems/Settings" },
    "/settings/{id}": { "$ref": "#/components/pathItems/SettingWithGet" },
    "/audit-logs": { "$ref": "#/components/pathItems/AuditLogs" },
    "/plugins": { "$ref": "#/components/pathItems/Plugins" },
    "/plugins/validate": { "$ref": "#/components/pathItems/PluginValidate" }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "go_reactrouter_access_token" },
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "parameters": {
      "ID": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[1-9][0-9]*$" } },
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "PageSize": { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
      "Search": { "name": "search", "in": "query", "schema": { "type": "string" } }
    },
    "pathItems": {
      "UserWithGet": { "get": { "$ref": "#/components/x-operations/getUser" }, "put": { "$ref": "#/components/x-operations/updateUser" }, "delete": { "$ref": "#/components/x-operations/deleteUser" } },
      "RoleWithGet": { "get": { "$ref": "#/components/x-operations/getRole" }, "put": { "$ref": "#/components/x-operations/updateRole" }, "delete": { "$ref": "#/components/x-operations/deleteRole" } },
      "PermissionWithGet": { "get": { "$ref": "#/components/x-operations/getPermission" }, "put": { "$ref": "#/components/x-operations/updatePermission" }, "delete": { "$ref": "#/components/x-operations/deletePermission" } },
      "MenuWithGet": { "get": { "$ref": "#/components/x-operations/getMenu" }, "put": { "$ref": "#/components/x-operations/updateMenu" }, "delete": { "$ref": "#/components/x-operations/deleteMenu" } },
      "SettingWithGet": { "get": { "$ref": "#/components/x-operations/getSetting" }, "put": { "$ref": "#/components/x-operations/updateSetting" }, "delete": { "$ref": "#/components/x-operations/deleteSetting" } },
      "Users": { "get": { "$ref": "#/components/x-operations/listUsers" }, "post": { "$ref": "#/components/x-operations/createUser" } },
      "User": { "put": { "$ref": "#/components/x-operations/updateUser" }, "delete": { "$ref": "#/components/x-operations/deleteUser" } },
      "Roles": { "get": { "$ref": "#/components/x-operations/listRoles" }, "post": { "$ref": "#/components/x-operations/createRole" } },
      "Role": { "put": { "$ref": "#/components/x-operations/updateRole" }, "delete": { "$ref": "#/components/x-operations/deleteRole" } },
      "Permissions": { "get": { "$ref": "#/components/x-operations/listPermissions" }, "post": { "$ref": "#/components/x-operations/createPermission" } },
      "Permission": { "put": { "$ref": "#/components/x-operations/updatePermission" }, "delete": { "$ref": "#/components/x-operations/deletePermission" } },
      "Menus": { "get": { "$ref": "#/components/x-operations/listMenus" }, "post": { "$ref": "#/components/x-operations/createMenu" } },
      "Menu": { "put": { "$ref": "#/components/x-operations/updateMenu" }, "delete": { "$ref": "#/components/x-operations/deleteMenu" } },
      "Settings": { "get": { "$ref": "#/components/x-operations/listSettings" }, "post": { "$ref": "#/components/x-operations/createSetting" } },
      "Setting": { "put": { "$ref": "#/components/x-operations/updateSetting" }, "delete": { "$ref": "#/components/x-operations/deleteSetting" } },
      "AuditLogs": { "get": { "$ref": "#/components/x-operations/listAuditLogs" } },
      "Plugins": { "get": { "$ref": "#/components/x-operations/listPlugins" } },
      "PluginValidate": { "post": { "$ref": "#/components/x-operations/validatePlugin" } }
    },
    "x-operations": {
      "getUser": { "operationId": "getUser", "summary": "Read a Core user", "x-permission": "users.view", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ID" }], "responses": { "200": { "$ref": "#/components/responses/UserResponse" }, "401": { "$ref": "#/components/responses/ApiErrorResponse" }, "403": { "$ref": "#/components/responses/ApiErrorResponse" }, "404": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "getRole": { "operationId": "getRole", "summary": "Read a Core role", "x-permission": "roles.view", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ID" }], "responses": { "200": { "$ref": "#/components/responses/RoleResponse" }, "401": { "$ref": "#/components/responses/ApiErrorResponse" }, "403": { "$ref": "#/components/responses/ApiErrorResponse" }, "404": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "getPermission": { "operationId": "getPermission", "summary": "Read a Core permission", "x-permission": "permissions.view", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ID" }], "responses": { "200": { "$ref": "#/components/responses/PermissionResponse" }, "401": { "$ref": "#/components/responses/ApiErrorResponse" }, "403": { "$ref": "#/components/responses/ApiErrorResponse" }, "404": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "getMenu": { "operationId": "getMenu", "summary": "Read a Core menu", "x-permission": "menus.view", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ID" }], "responses": { "200": { "$ref": "#/components/responses/MenuResponse" }, "401": { "$ref": "#/components/responses/ApiErrorResponse" }, "403": { "$ref": "#/components/responses/ApiErrorResponse" }, "404": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "getSetting": { "operationId": "getSetting", "summary": "Read a Core setting", "x-permission": "settings.view", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ID" }], "responses": { "200": { "$ref": "#/components/responses/SettingResponse" }, "401": { "$ref": "#/components/responses/ApiErrorResponse" }, "403": { "$ref": "#/components/responses/ApiErrorResponse" }, "404": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "listUsers": { "operationId": "listUsers", "summary": "List Core users", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PageSize" }, { "$ref": "#/components/parameters/Search" }], "responses": { "200": { "$ref": "#/components/responses/UserListResponse" }, "401": { "$ref": "#/components/responses/ApiErrorResponse" }, "403": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "createUser": { "operationId": "createUser", "summary": "Create a Core user", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/UserWriteRequest" }, "responses": { "201": { "$ref": "#/components/responses/UserResponse" }, "422": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "updateUser": { "operationId": "updateUser", "summary": "Update a Core user", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ID" }], "requestBody": { "$ref": "#/components/requestBodies/UserWriteRequest" }, "responses": { "200": { "$ref": "#/components/responses/UserResponse" }, "404": { "$ref": "#/components/responses/ApiErrorResponse" }, "422": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "deleteUser": { "operationId": "deleteUser", "summary": "Delete a Core user", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ID" }], "responses": { "204": { "$ref": "#/components/responses/NoContentResponse" }, "404": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "listRoles": { "operationId": "listRoles", "summary": "List Core roles", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PageSize" }, { "$ref": "#/components/parameters/Search" }], "responses": { "200": { "$ref": "#/components/responses/RoleListResponse" }, "401": { "$ref": "#/components/responses/ApiErrorResponse" }, "403": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "createRole": { "operationId": "createRole", "summary": "Create a Core role", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/RoleWriteRequest" }, "responses": { "201": { "$ref": "#/components/responses/RoleResponse" }, "422": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "updateRole": { "operationId": "updateRole", "summary": "Update a Core role", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ID" }], "requestBody": { "$ref": "#/components/requestBodies/RoleWriteRequest" }, "responses": { "200": { "$ref": "#/components/responses/RoleResponse" }, "404": { "$ref": "#/components/responses/ApiErrorResponse" }, "422": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "deleteRole": { "operationId": "deleteRole", "summary": "Delete a Core role", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ID" }], "responses": { "204": { "$ref": "#/components/responses/NoContentResponse" }, "404": { "$ref": "#/components/responses/ApiErrorResponse" }, "409": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "listPermissions": { "operationId": "listPermissions", "summary": "List Core permissions", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PageSize" }, { "$ref": "#/components/parameters/Search" }], "responses": { "200": { "$ref": "#/components/responses/PermissionListResponse" }, "401": { "$ref": "#/components/responses/ApiErrorResponse" }, "403": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "createPermission": { "operationId": "createPermission", "summary": "Create a Core permission", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/PermissionWriteRequest" }, "responses": { "201": { "$ref": "#/components/responses/PermissionResponse" }, "422": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "updatePermission": { "operationId": "updatePermission", "summary": "Update a Core permission", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ID" }], "requestBody": { "$ref": "#/components/requestBodies/PermissionWriteRequest" }, "responses": { "200": { "$ref": "#/components/responses/PermissionResponse" }, "404": { "$ref": "#/components/responses/ApiErrorResponse" }, "422": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "deletePermission": { "operationId": "deletePermission", "summary": "Delete a Core permission", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ID" }], "responses": { "204": { "$ref": "#/components/responses/NoContentResponse" }, "404": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "listMenus": { "operationId": "listMenus", "summary": "List visible and authorized Core menus", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PageSize" }, { "$ref": "#/components/parameters/Search" }], "responses": { "200": { "$ref": "#/components/responses/MenuListResponse" }, "401": { "$ref": "#/components/responses/ApiErrorResponse" }, "403": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "createMenu": { "operationId": "createMenu", "summary": "Create a Core menu", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/MenuWriteRequest" }, "responses": { "201": { "$ref": "#/components/responses/MenuResponse" }, "422": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "updateMenu": { "operationId": "updateMenu", "summary": "Update a Core menu", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ID" }], "requestBody": { "$ref": "#/components/requestBodies/MenuWriteRequest" }, "responses": { "200": { "$ref": "#/components/responses/MenuResponse" }, "404": { "$ref": "#/components/responses/ApiErrorResponse" }, "422": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "deleteMenu": { "operationId": "deleteMenu", "summary": "Delete a Core menu", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ID" }], "responses": { "204": { "$ref": "#/components/responses/NoContentResponse" }, "404": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "listSettings": { "operationId": "listSettings", "summary": "List Core settings", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PageSize" }, { "$ref": "#/components/parameters/Search" }], "responses": { "200": { "$ref": "#/components/responses/SettingListResponse" }, "401": { "$ref": "#/components/responses/ApiErrorResponse" }, "403": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "createSetting": { "operationId": "createSetting", "summary": "Create a Core setting", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/SettingWriteRequest" }, "responses": { "201": { "$ref": "#/components/responses/SettingResponse" }, "422": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "updateSetting": { "operationId": "updateSetting", "summary": "Update a Core setting", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ID" }], "requestBody": { "$ref": "#/components/requestBodies/SettingWriteRequest" }, "responses": { "200": { "$ref": "#/components/responses/SettingResponse" }, "404": { "$ref": "#/components/responses/ApiErrorResponse" }, "422": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "deleteSetting": { "operationId": "deleteSetting", "summary": "Delete a Core setting", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/ID" }], "responses": { "204": { "$ref": "#/components/responses/NoContentResponse" }, "404": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "listAuditLogs": { "operationId": "listAuditLogs", "summary": "List audit logs", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PageSize" }, { "$ref": "#/components/parameters/Search" }], "responses": { "200": { "$ref": "#/components/responses/AuditLogListResponse" }, "401": { "$ref": "#/components/responses/ApiErrorResponse" }, "403": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "listPlugins": { "operationId": "listPlugins", "summary": "List validated plugins", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PageSize" }, { "$ref": "#/components/parameters/Search" }], "responses": { "200": { "$ref": "#/components/responses/PluginListResponse" }, "401": { "$ref": "#/components/responses/ApiErrorResponse" }, "403": { "$ref": "#/components/responses/ApiErrorResponse" } } },
      "validatePlugin": { "operationId": "validatePlugin", "summary": "Validate and record a plugin package", "x-permission": "plugins.validate", "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }], "requestBody": { "$ref": "#/components/requestBodies/PluginValidateRequest" }, "responses": { "201": { "$ref": "#/components/responses/PluginValidationResponse" }, "401": { "$ref": "#/components/responses/ApiErrorResponse" }, "403": { "$ref": "#/components/responses/ApiErrorResponse" }, "422": { "$ref": "#/components/responses/ApiErrorResponse" }, "500": { "$ref": "#/components/responses/ApiErrorResponse" } } }
    },
    "requestBodies": {
      "UserWriteRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserWriteRequest" } } } },
      "RoleWriteRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoleWriteRequest" } } } },
      "PermissionWriteRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PermissionWriteRequest" } } } },
      "MenuWriteRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MenuWriteRequest" } } } },
      "SettingWriteRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SettingWriteRequest" } } } }
      ,"PluginValidateRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PluginValidateRequest" } } } }
    },
    "schemas": {
      "UserWriteRequest": { "type": "object", "required": ["name", "email"], "properties": { "name": { "type": "string", "minLength": 1 }, "email": { "type": "string", "format": "email" }, "password": { "type": "string", "minLength": 1, "writeOnly": true }, "status": { "type": "string", "enum": ["active", "disabled"] }, "is_active": { "type": "boolean" }, "role_ids": { "type": "array", "items": { "type": "integer", "minimum": 1 } } } },
      "RoleWriteRequest": { "type": "object", "required": ["name", "display_name"], "properties": { "name": { "type": "string", "minLength": 1 }, "display_name": { "type": "string", "minLength": 1 }, "description": { "type": ["string", "null"] }, "is_system": { "type": "boolean" }, "permission_ids": { "type": "array", "items": { "type": "integer", "minimum": 1 } } } },
      "PermissionWriteRequest": { "type": "object", "required": ["code", "display_name"], "properties": { "code": { "type": "string", "minLength": 1 }, "display_name": { "type": "string", "minLength": 1 }, "description": { "type": ["string", "null"] }, "module_id": { "type": ["string", "null"] } } },
      "MenuWriteRequest": { "type": "object", "required": ["key", "label"], "properties": { "key": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 }, "path": { "type": ["string", "null"] }, "icon": { "type": ["string", "null"] }, "permission": { "type": ["string", "null"] }, "parent_id": { "type": ["integer", "null"], "minimum": 1 }, "sort": { "type": "integer" }, "is_visible": { "type": "boolean" }, "meta": { "type": ["string", "null"] } } },
      "SettingWriteRequest": { "type": "object", "required": ["key", "value"], "properties": { "key": { "type": "string", "minLength": 1 }, "value": { "type": "string" }, "type": { "type": "string", "default": "string" }, "is_public": { "type": "boolean" } } },
      "UserListItem": { "type": "object", "required": ["id", "name", "email", "status", "is_active"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "email": { "type": "string", "format": "email" }, "status": { "type": "string" }, "is_active": { "type": "boolean" } } },
      "RoleListItem": { "type": "object", "required": ["id", "name", "display_name", "is_system", "permissions"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "display_name": { "type": "string" }, "description": { "type": ["string", "null"] }, "is_system": { "type": "boolean" }, "permissions": { "type": "array", "items": { "type": "string" } } } },
      "PermissionListItem": { "type": "object", "required": ["id", "code", "display_name"], "properties": { "id": { "type": "string" }, "code": { "type": "string" }, "display_name": { "type": "string" }, "description": { "type": ["string", "null"] }, "module_id": { "type": ["string", "null"] } } },
      "MenuListItem": { "type": "object", "required": ["id", "key", "label", "sort", "is_visible"], "properties": { "id": { "type": "string" }, "key": { "type": "string" }, "label": { "type": "string" }, "path": { "type": ["string", "null"] }, "icon": { "type": ["string", "null"] }, "permission": { "type": ["string", "null"] }, "parent_id": { "type": ["string", "null"] }, "sort": { "type": "integer" }, "is_visible": { "type": "boolean" }, "meta": { "type": ["string", "null"] } } },
      "SettingListItem": { "type": "object", "required": ["id", "key", "value", "type", "is_public"], "properties": { "id": { "type": "string" }, "key": { "type": "string" }, "value": { "type": "string" }, "type": { "type": "string" }, "is_public": { "type": "boolean" } } },
      "AuditLogListItem": { "type": "object", "required": ["id", "action", "resource_type"], "properties": { "id": { "type": "string" }, "user_id": { "type": ["string", "null"] }, "action": { "type": "string" }, "resource_type": { "type": "string" }, "resource_id": { "type": ["string", "null"] }, "request_id": { "type": ["string", "null"] }, "before_data": { "type": ["string", "null"] }, "after_data": { "type": ["string", "null"] } } },
      "PluginValidateRequest": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } } },
      "PluginDependency": { "type": "object", "required": ["id", "version"], "properties": { "id": { "type": "string" }, "version": { "type": "string" } } },
      "PluginListItem": { "type": "object", "required": ["id", "plugin_id", "name", "display_name", "state", "dependencies", "health_status"], "properties": { "id": { "type": "string" }, "plugin_id": { "type": "string" }, "name": { "type": "string" }, "display_name": { "type": "string" }, "state": { "type": "string" }, "current_version": { "type": "string" }, "dependencies": { "type": "array", "items": { "$ref": "#/components/schemas/PluginDependency" } }, "last_error": { "type": ["string", "null"] }, "health_status": { "type": "string" } } },
      "PluginVersionListItem": { "type": "object", "required": ["id", "version", "package_hash", "state", "health_status"], "properties": { "id": { "type": "string" }, "version": { "type": "string" }, "package_hash": { "type": "string" }, "signature_key_id": { "type": ["string", "null"] }, "state": { "type": "string" }, "health_status": { "type": "string" } } },
      "PluginValidationResult": { "type": "object", "required": ["plugin", "version"], "properties": { "plugin": { "$ref": "#/components/schemas/PluginListItem" }, "version": { "$ref": "#/components/schemas/PluginVersionListItem" } } },
      "PageMeta": { "type": "object", "required": ["page", "pageSize", "total"], "properties": { "page": { "type": "integer" }, "pageSize": { "type": "integer" }, "total": { "type": "integer" } } },
      "ListEnvelope": { "type": "object", "required": ["data", "meta"], "properties": { "data": { "type": "array" }, "meta": { "$ref": "#/components/schemas/PageMeta" }, "requestId": { "type": "string" } } },
