{
  "openapi": "3.1.0",
  "info": {
    "title": "GoReactRouter Core API",
    "version": "1.0.0",
    "description": "Generated aggregation of Core authentication and admin contracts."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "x-permission": "public",
        "summary": "Authenticate a Core user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/AuthUserResponse"
          },
          "422": {
            "$ref": "#/components/responses/ApiErrorResponse"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "x-permission": "auth.me",
        "summary": "Read the current authenticated user",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/AuthUserResponse"
          },
          "401": {
            "$ref": "#/components/responses/ApiErrorResponse"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "x-permission": "auth.logout",
        "summary": "Invalidate the current authentication token",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Authentication token invalidated"
          },
          "401": {
            "$ref": "#/components/responses/ApiErrorResponse"
          }
        }
      }
    },
    "/api/v1/admin/users": {
      "$ref": "#/components/pathItems/Users"
    },
    "/api/v1/admin/users/{id}": {
      "$ref": "#/components/pathItems/UserWithGet"
    },
    "/api/v1/admin/roles": {
      "$ref": "#/components/pathItems/Roles"
    },
    "/api/v1/admin/roles/{id}": {
      "$ref": "#/components/pathItems/Role"
    },
    "/api/v1/admin/permissions": {
      "$ref": "#/components/pathItems/Permissions"
    },
    "/api/v1/admin/permissions/{id}": {
      "$ref": "#/components/pathItems/Permission"
    },
    "/api/v1/admin/menus": {
      "$ref": "#/components/pathItems/Menus"
    },
    "/api/v1/admin/menus/{id}": {
      "$ref": "#/components/pathItems/Menu"
    },
    "/api/v1/admin/settings": {
      "$ref": "#/components/pathItems/Settings"
    },
    "/api/v1/admin/settings/{id}": {
      "$ref": "#/components/pathItems/Setting"
    },
    "/api/v1/admin/audit-logs": {
      "$ref": "#/components/pathItems/AuditLogs"
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "go_reactrouter_access_token"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "AuthUser": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "roles",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "UserWriteRequest": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          },
          "is_active": {
            "type": "boolean"
          },
          "role_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "RoleWriteRequest": {
        "type": "object",
        "required": [
          "name",
          "display_name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_system": {
            "type": "boolean"
          },
          "permission_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "PermissionWriteRequest": {
        "type": "object",
        "required": [
          "code",
          "display_name"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "module_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "MenuWriteRequest": {
        "type": "object",
        "required": [
          "key",
          "label"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "permission": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent_id": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "sort": {
            "type": "integer"
          },
          "is_visible": {
            "type": "boolean"
          },
          "meta": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SettingWriteRequest": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "default": "string"
          },
          "is_public": {
            "type": "boolean"
          }
        }
      },
      "UserListItem": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "status",
          "is_active"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "status": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "RoleListItem": {
        "type": "object",
        "required": [
          "id",
          "name",
          "display_name",
          "is_system"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_system": {
            "type": "boolean"
          }
        }
      },
      "PermissionListItem": {
        "type": "object",
        "required": [
          "id",
          "code",
          "display_name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "module_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "MenuListItem": {
        "type": "object",
        "required": [
          "id",
          "key",
          "label",
          "sort",
          "is_visible"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "permission": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "sort": {
            "type": "integer"
          },
          "is_visible": {
            "type": "boolean"
          },
          "meta": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SettingListItem": {
        "type": "object",
        "required": [
          "id",
          "key",
          "value",
          "type",
          "is_public"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "is_public": {
            "type": "boolean"
          }
        }
      },
      "AuditLogListItem": {
        "type": "object",
        "required": [
          "id",
          "action",
          "resource_type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "user_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "type": "string"
          },
          "resource_type": {
            "type": "string"
          },
          "resource_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "before_data": {
            "type": [
              "string",
              "null"
            ]
          },
          "after_data": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PageMeta": {
        "type": "object",
        "required": [
          "page",
          "pageSize",
          "total"
        ],
        "properties": {
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "ListEnvelope": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "UserListEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ListEnvelope"
          },
          {
            "properties": {
              "data": {
                "items": {
                  "$ref": "#/components/schemas/UserListItem"
                }
              }
            }
          }
        ]
      },
      "RoleListEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ListEnvelope"
          },
          {
            "properties": {
              "data": {
                "items": {
                  "$ref": "#/components/schemas/RoleListItem"
                }
              }
            }
          }
        ]
      },
      "PermissionListEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ListEnvelope"
          },
          {
            "properties": {
              "data": {
                "items": {
                  "$ref": "#/components/schemas/PermissionListItem"
                }
              }
            }
          }
        ]
      },
      "MenuListEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ListEnvelope"
          },
          {
            "properties": {
              "data": {
                "items": {
                  "$ref": "#/components/schemas/MenuListItem"
                }
              }
            }
          }
        ]
      },
      "SettingListEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ListEnvelope"
          },
          {
            "properties": {
              "data": {
                "items": {
                  "$ref": "#/components/schemas/SettingListItem"
                }
              }
            }
          }
        ]
      },
      "AuditLogListEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ListEnvelope"
          },
          {
            "properties": {
              "data": {
                "items": {
                  "$ref": "#/components/schemas/AuditLogListItem"
                }
              }
            }
          }
        ]
      },
      "ResourceEnvelope": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object"
          },
          "requestId": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "AuthUserResponse": {
        "description": "Authenticated user",
        "headers": {
          "Set-Cookie": {
            "schema": {
              "type": "string"
            },
            "description": "HttpOnly access token cookie"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "data"
              ],
              "properties": {
                "data": {
                  "$ref": "#/components/schemas/AuthUser"
                },
                "message": {
                  "type": "string"
                },
                "requestId": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ApiErrorResponse": {
        "description": "API error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "UserListResponse": {
        "description": "Paginated users",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UserListEnvelope"
            }
          }
        }
      },
      "RoleListResponse": {
        "description": "Paginated roles",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RoleListEnvelope"
            }
          }
        }
      },
      "PermissionListResponse": {
        "description": "Paginated permissions",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/PermissionListEnvelope"
            }
          }
        }
      },
      "MenuListResponse": {
        "description": "Paginated authorized menus",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MenuListEnvelope"
            }
          }
        }
      },
      "SettingListResponse": {
        "description": "Paginated settings",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SettingListEnvelope"
            }
          }
        }
      },
      "AuditLogListResponse": {
        "description": "Paginated audit logs",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AuditLogListEnvelope"
            }
          }
        }
      },
      "UserResponse": {
        "description": "User resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ResourceEnvelope"
            }
          }
        }
      },
      "RoleResponse": {
        "description": "Role resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ResourceEnvelope"
            }
          }
        }
      },
      "PermissionResponse": {
        "description": "Permission resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ResourceEnvelope"
            }
          }
        }
      },
      "MenuResponse": {
        "description": "Menu resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ResourceEnvelope"
            }
          }
        }
      },
      "SettingResponse": {
        "description": "Setting resource",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ResourceEnvelope"
            }
          }
        }
      },
      "NoContentResponse": {
        "description": "Resource deleted"
      }
    },
    "parameters": {
      "ID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "Search": {
        "name": "search",
        "in": "query",
        "schema": {
          "type": "string"
        }
      }
    },
    "pathItems": {
      "UserWithGet": {
        "get": {
          "$ref": "#/components/x-operations/getUser"
        },
        "put": {
          "$ref": "#/components/x-operations/updateUser"
        },
        "delete": {
          "$ref": "#/components/x-operations/deleteUser"
        }
      },
      "Users": {
        "get": {
          "$ref": "#/components/x-operations/listUsers"
        },
        "post": {
          "$ref": "#/components/x-operations/createUser"
        }
      },
      "User": {
        "put": {
          "$ref": "#/components/x-operations/updateUser"
        },
        "delete": {
          "$ref": "#/components/x-operations/deleteUser"
        }
      },
      "Roles": {
        "get": {
          "$ref": "#/components/x-operations/listRoles"
        },
        "post": {
          "$ref": "#/components/x-operations/createRole"
        }
      },
      "Role": {
        "put": {
          "$ref": "#/components/x-operations/updateRole"
        },
        "delete": {
          "$ref": "#/components/x-operations/deleteRole"
        }
      },
      "Permissions": {
        "get": {
          "$ref": "#/components/x-operations/listPermissions"
        },
        "post": {
          "$ref": "#/components/x-operations/createPermission"
        }
      },
      "Permission": {
        "put": {
          "$ref": "#/components/x-operations/updatePermission"
        },
        "delete": {
          "$ref": "#/components/x-operations/deletePermission"
        }
      },
      "Menus": {
        "get": {
          "$ref": "#/components/x-operations/listMenus"
        },
        "post": {
          "$ref": "#/components/x-operations/createMenu"
        }
      },
      "Menu": {
        "put": {
          "$ref": "#/components/x-operations/updateMenu"
        },
        "delete": {
          "$ref": "#/components/x-operations/deleteMenu"
        }
      },
      "Settings": {
        "get": {
          "$ref": "#/components/x-operations/listSettings"
        },
        "post": {
          "$ref": "#/components/x-operations/createSetting"
        }
      },
      "Setting": {
        "put": {
          "$ref": "#/components/x-operations/updateSetting"
        },
        "delete": {
          "$ref": "#/components/x-operations/deleteSetting"
        }
      },
      "AuditLogs": {
        "get": {
          "$ref": "#/components/x-operations/listAuditLogs"
        }
      }
    },
    "x-operations": {
      "getUser": {
        "operationId": "getUser",
        "summary": "Read a Core user",
        "x-permission": "users.view",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ID"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/UserResponse"
          },
          "401": {
            "$ref": "#/components/responses/ApiErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/ApiErrorResponse"
          },
          "404": {
            "$ref": "#/components/responses/ApiErrorResponse"
          }
        }
      },
      "listUsers": {
        "operationId": "listUsers",
        "summary": "List Core users",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "$ref": "#/components/parameters/Search"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/UserListResponse"
          },
          "401": {
            "$ref": "#/components/responses/ApiErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/ApiErrorResponse"
          }
        }
      },
      "createUser": {
        "operationId": "createUser",
