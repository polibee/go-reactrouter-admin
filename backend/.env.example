APP_NAME=Goravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=3000

JWT_SECRET=

AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_BASE_URL=

# Supported values: postgres, postgresql, mysql, mariadb.
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
# Leave empty to use 5432 for PostgreSQL or 3306 for MySQL.
DB_PORT=
DB_DATABASE=go_reactrouter
DB_USERNAME=go_reactrouter
DB_PASSWORD=
DB_SCHEMA=public
DB_CHARSET=utf8mb4
DB_TIMEZONE=UTC

# Enables the destructive real-database test suite only when set to 1.
DB_INTEGRATION=0

GRPC_HOST=
GRPC_PORT=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
