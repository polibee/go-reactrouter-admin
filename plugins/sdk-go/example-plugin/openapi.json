{
  "openapi": "3.1.0",
  "info": {
    "title": "Example Plugin API",
    "version": "1.0.0"
  },
  "x-plugin-id": "example.plugin",
  "servers": [{ "url": "/api/v1/plugins/example.plugin" }],
  "paths": {
    "/hello": {
      "get": {
        "operationId": "getHello",
        "x-permission": "example.plugin.view",
        "summary": "Read the example plugin greeting",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": {
          "200": {
            "$ref": "#/components/responses/HelloResponse"
          },
          "401": { "$ref": "#/components/responses/ApiErrorResponse" },
          "403": { "$ref": "#/components/responses/ApiErrorResponse" },
          "502": { "$ref": "#/components/responses/ApiErrorResponse" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "go_reactrouter_access_token" },
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Hello": {
        "type": "object",
        "required": ["message"],
        "properties": { "message": { "type": "string" } }
      },
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "fields": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
            }
          },
          "requestId": { "type": "string" }
        }
      },
      "HelloEnvelope": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/Hello" } }
      }
    },
    "responses": {
      "HelloResponse": {
        "description": "Plugin greeting",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HelloEnvelope" } } }
      },
      "ApiErrorResponse": {
        "description": "Plugin API error",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      }
    }
  },
  "x-permissions": { "getHello": "example.plugin.view" }
}
